# ---- Versions (verify tags exist on Docker Hub before first run) ---------------
TEMPORAL_VERSION=1.32.0
UI_VERSION=2.54.1
PROM_VERSION=v3.1.0
GRAFANA_VERSION=11.6.0
CADVISOR_VERSION=v0.49.1
PGEXP_VERSION=v0.16.0
TOXIPROXY_VERSION=2.9.0
POSTGRES_VERSION=16-alpine

# ---- Cluster shape ---------------------------------------------------------------
# FIXED AT FIRST BOOT. To change: `make reset SHARDS=512` (wipes the database).
NUM_HISTORY_SHARDS=4
SERVER_LOG_LEVEL=info
# "no" lets you control restarts explicitly with chaos/chaos.sh. Use "on-failure" or
# "unless-stopped" to mimic an orchestrator that restarts crashed pods.
RESTART_POLICY=no

# ---- Postgres --------------------------------------------------------------------
PG_HOST_PORT=15432
# Try "off" to see how much of persistence latency is the fsync on commit.
PG_SYNC_COMMIT=on

# ---- SDK worker tuning (empty = SDK default). Applied on `make up` / `make workers` ----
# Leave the W_* values empty for the baseline, then change one at a time.
W_MAX_CONCURRENT_WORKFLOW_TASKS=
W_MAX_CONCURRENT_ACTIVITIES=
W_MAX_CONCURRENT_WORKFLOW_TASK_POLLS=
W_MAX_CONCURRENT_ACTIVITY_TASK_POLLS=
W_MAX_CACHED_WORKFLOWS=
W_ACTIVITY_THREADS=
W_STICKY_QUEUE_TIMEOUT_S=
W_MAX_ACTIVITIES_PER_SECOND=
W_MAX_TASK_QUEUE_ACTIVITIES_PER_SECOND=
# fixed | resource   (resource = ResourceBasedTuner; ignores the max_concurrent_* values)
W_TUNER=fixed
# 0 | 1   (1 = PollerBehaviorAutoscaling; ignores the *_POLLS values)
W_POLLER_AUTOSCALE=0
W_GRACEFUL_SHUTDOWN_S=5
# 1 = disable the SDK deadlock detector (so a busy-looping workflow hits the SERVER's task timeout)
W_DEBUG_MODE=0
W_LOG_LEVEL=INFO

# ---- Which workflow code the workers run (Phase 4 #11: non-determinism) ----------
# v1 = A,B,wait,C   v2 = B,A,wait,C (breaks replay)   v3 = v2 wrapped in workflow.patched()
EVOLVING_VARIANT=v1

# ---- Host ports (change if another local Temporal stack already uses them) ----------
FRONTEND_HOST_PORTS=7233-7243
UI_HOST_PORT=8080
PROM_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
TOXIPROXY_HOST_PORT=8474
