    "w": 24,
    "x": 0,
    "y": 9
   },
   "panels": []
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Workflow task schedule\u2192start p50 / p99 (ms)",
   "description": "Should be ~0. Rising = not enough workflow-task capacity (slots, pollers, CPU, cache misses).",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 4,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le, task_queue) (rate(temporal_workflow_task_schedule_to_start_latency_bucket[$__rate_interval])))",
     "legendFormat": "p50 {{task_queue}}",
     "editorMode": "code"
    },
    {
     "refId": "B",
