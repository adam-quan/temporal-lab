{
 "id": null,
 "uid": "temporal-lab",
 "title": "Temporal Lab",
 "tags": [
  "temporal",
  "lab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "graphTooltip": 1,
 "templating": {
  "list": []
 },
 "annotations": {
  "list": [
   {
    "name": "chaos events",
    "enable": true,
    "iconColor": "red",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "target": {
     "type": "tags",
     "tags": [
      "chaos"
     ],
     "limit": 200,
     "matchAny": false
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "1. Load generator (client view)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Client requests/s by operation",
   "description": "What the load generator actually sent. Compare with the target rate in the loadgen output.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 4,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (operation) (rate(temporal_request{job=\"loadgen\"}[$__rate_interval]))",
     "legendFormat": "{{operation}}",
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Client request FAILURES/s by status",
   "description": "RESOURCE_EXHAUSTED here = the server is rate limiting. The SDK retries these transparently, so they show up as latency first.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 4,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (operation, status_code) (rate(temporal_request_failure{job=\"loadgen\"}[$__rate_interval]))",
     "legendFormat": "{{operation}} {{status_code}}",
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Client StartWorkflow latency p50 / p99 (ms)",
   "description": "Includes SDK-internal retries. The loadgen table reports the same thing per step.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 4,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(temporal_request_latency_bucket{job=\"loadgen\",operation=~\"StartWorkflowExecution|SignalWithStartWorkflowExecution\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "editorMode": "code"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(temporal_request_latency_bucket{job=\"loadgen\",operation=~\"StartWorkflowExecution|SignalWithStartWorkflowExecution\"}[$__rate_interval])))",
     "legendFormat": "p99",
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 5,
   "type": "row",
   "title": "2. SDK workers: the queueing signal (schedule-to-start) and worker health",
   "collapsed": false,
   "gridPos": {
